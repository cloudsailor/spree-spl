<button type="button"
        class="btn-primary w-full mb-6"
        id="loyalty-connect-toggle">
  <%= I18n.t('spl.profile.connect_button') %>
</button>

<div id="loyalty-connect-container" class="mt-3" style="display: none;">
  <%= render 'spl/loyalty_connect_form' %>
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    var btn = document.getElementById("loyalty-connect-toggle");
    var container = document.getElementById("loyalty-connect-container");

    if (!btn || !container) return;

    btn.addEventListener("click", function() {
      if (container.style.display === "none" || container.style.display === "") {
        container.style.display = "block";
      } else {
        container.style.display = "none";
      }
    });
  });
</script>
