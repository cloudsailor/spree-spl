<%= turbo_frame_tag "loyalty_connect_form" do %>
  <%= render partial: 'spree/shared/error_messages', locals: { target: @user } %>

  <div class="mb-6 flex items-start gap-2">
    <%= check_box_tag :has_account, '1', true, id: 'has_account_checkbox', class: 'mt-1' %>
    <%= label_tag :has_account, I18n.t('spl.user.have_account'), class: 'text-sm text-neutral-700' %>
  </div>

  <div id="login_form">
    <%= form_with scope: :user, url: login_code_account_profile_path, method: :patch, data: { turbo_frame: "loyalty_connect_form" } do |f| %>
      <div class="mb-4">
        <%= f.label :phone,
                    Spree.t(:phone),
                    class: 'text-xs text-neutral-600 block mb-2' %>
        <%= f.telephone_field :phone,
                              class: 'text-input w-full',
                              placeholder: Spree.t('loyalty.phone_label'),
                              value: try_spree_current_user&.phone %>
      </div>

      <div class="mb-4 flex items-start gap-2">
        <%= f.check_box :accept_yc_terms,
                        {
                          class: 'mt-1',
                          checked: ActiveModel::Type::Boolean.new.cast(
                            try_spree_current_user&.public_metadata&.fetch('accept_yc_terms', false)
                          )
                        },
                        'true',
                        'false' %>
        <%= f.label :accept_yc_terms, I18n.t('spl.user.accept_yc_terms_label'), class: 'text-sm text-neutral-700' %>
      </div>

      <div>
        <%= f.submit I18n.t('buttons.send_log_in_code'), class: 'btn-primary w-full' %>
      </div>
    <% end %>
  </div>

  <div id="registration_form" class="hidden">
    <%= form_with scope: :user, url: registration_code_account_profile_path, method: :patch, data: { turbo_frame: 'loyalty_otp_form' } do |f| %>
      <div class="mb-4">
        <%= f.label :phone, Spree.t(:phone), class: 'text-xs text-neutral-600 block mb-2' %>
        <%= f.telephone_field :phone,
                              class: 'text-input w-full',
                              placeholder: Spree.t('loyalty.phone_label'),
                              value: try_spree_current_user&.phone %>
      </div>

      <div class="mb-4 flex items-start gap-2">
        <%= f.check_box :accept_yc_terms,
                        {
                          class: 'mt-1',
                          checked: ActiveModel::Type::Boolean.new.cast(
                            try_spree_current_user&.public_metadata&.fetch('accept_yc_terms', false)
                          )
                        },
                        'true',
                        'false' %>
        <%= f.label :accept_yc_terms, I18n.t('spl.user.accept_yc_terms_label'), class: 'text-sm text-neutral-700' %>
      </div>

      <div><%= f.submit I18n.t('buttons.send_registration_code'), class: 'btn-primary w-full' %></div>
    <% end %>
  </div>
<% end %>
